{
  "outputDirectory": "src",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/about", "dest": "/about.html" },
    { "src": "/products", "dest": "/products.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/resources", "dest": "/resources.html" },
    { "src": "/price-list", "dest": "/price-list.html" },
    { "src": "/applications", "dest": "/applications.html" },
    { "src": "/projects", "dest": "/projects.html" },
    { "src": "/manufacturing", "dest": "/manufacturing.html" },
    { "src": "/professionals", "dest": "/professionals.html" },
    { "src": "/product-details", "dest": "/product-details.html" },
    { "src": "/legal", "dest": "/legal.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
